        {
          "n": "rule_id",
          "t": "int",
          "d": "내역에 부여된 규칙. 적립 건의 규칙과 다를 수 있다.",
          "key": true
        },
        {
          "n": "user_id",
          "t": "int",
          "d": "유저"
        },
        {
          "n": "entry_type",
          "t": "int",
          "d": "**0 적립, 1 사용, 2 회수.**",
          "key": true,
          "er": true
        },
        {
          "n": "delta",
          "t": "int",
          "d": "**변동액.** 사용·회수는 음수이다.",
          "key": true
        },
        {
          "n": "ref_type",
          "t": "varchar(30)",
          "d": "내역 발생 원인(order_pay, order_cancel, admin 등)"
