{
  "kind": "data-model",
  "meta": {
    "title": "리워드 포인트 데이터 모델 (예제)",
    "eyebrow": "Reward Points · 가상 예제",
    "heading": "리워드 포인트 데이터 모델과 처리 흐름",
    "lead": "리워드 포인트는 reward_rules(규칙), reward_lots(적립 건), reward_entries(내역) 세 테이블로 구성된다. 적립 건이 잔액의 원천이고 내역은 변동 이력이며, 규칙은 양쪽에서 참조된다. 이 문서는 모든 기능을 한 번씩 쓰는 가상 예제이다.",
    "basis": "근거: 가상 스키마와 가상 값이다. 실제 서비스의 데이터가 아니다."
  },
  "overview": {
    "formula": "잔액 = SUM(reward_lots.remaining)  WHERE  user_id = :user  AND  remaining > 0  AND  expires_at > NOW()",
    "note": "DB 외래키는 없으며 참조 관계는 애플리케이션 규약이다."
  },
  "tables": [
    {
      "id": "rule",
      "name": "reward_rules",
      "role": "규칙",
      "tone": "c",
      "where": "shop",
      "summary": "적립 규칙 마스터. 종류, 만료 일수, 노출 여부를 정의한다.",
      "indexes": "인덱스: kind, (active, display_name)",
      "columns": [
        {
          "n": "id",
          "t": "int PK",
          "d": "규칙 식별자",
          "er": true
        },
        {
          "n": "kind",
          "t": "int",
          "d": "**-1 차감, 0 만료 없음, 1 일수형.** 적립 시 만료일 계산에만 쓰인다.",
          "key": true,
          "er": true
        },
        {
          "n": "expiry_days",
          "t": "int",
          "d": "일수형일 때 '오늘 + expiry_days'가 만료일이다."
        },
        {
          "n": "active",
          "t": "bit(1)",
          "d": "**노출 여부.** false이면 앱 목록에서 제외된다.",
          "key": true,
          "er": true
        },
        {
          "n": "display_name",
          "t": "varchar(64)",
          "d": "앱 목록 제목"
        }
      ]
    },
    {
      "id": "lot",
      "name": "reward_lots",
      "role": "적립 건",
      "tone": "a",
      "where": "shop",
      "summary": "적립 단위 행. 적립액, 잔여액, 만료 시각을 가지며 잔액 계산의 원천이다.",
      "indexes": "인덱스: user_id, rule_id",
      "columns": [
        {
          "n": "id",
          "t": "int PK",
          "d": "**적립 건 식별자.** 회수 API가 사용하는 값이며 목록의 ID와 다르다.",
          "key": true,
          "er": true
        },
        {
          "n": "rule_id",
          "t": "int",
          "d": "적립 시점의 규칙",
          "er": true
        },
        {
          "n": "user_id",
          "t": "int",
          "d": "수령 유저"
        },
        {
          "n": "granted",
          "t": "int",
          "d": "최초 적립액. 사용·회수로 변경되지 않는다."
        },
        {
          "n": "remaining",
          "t": "int",
          "d": "**현재 잔여액.** 사용·회수 시 감소하고 취소 복구 시 증가한다.",
          "key": true,
          "er": true
        },
        {
          "n": "expires_at",
          "t": "datetime",
          "d": "**만료 시각.** 경과하면 잔액 집계에서 제외된다.",
          "key": true
        }
      ]
    },
    {
      "id": "entry",
      "name": "reward_entries",
      "role": "내역",
      "tone": "b",
      "where": "shop",
      "summary": "변동 이력. 적립, 사용, 회수가 발생할 때 행이 추가된다.",
      "indexes": "인덱스: user_id, lot_id, (ref_type, ref_id)",
      "columns": [
        {
          "n": "id",
          "t": "int PK",
          "d": "내역 식별자. 관리자 목록의 ID 컬럼 값이다.",
