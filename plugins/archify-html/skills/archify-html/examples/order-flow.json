            {
              "s": "pay.charges",
              "op": "WU",
              "n": "INSERT 후 status 갱신",
              "e": "ChargeRepository.java",
              "c": 1
            },
            {
              "s": "pay.charge_events",
              "op": "W",
              "e": "ChargeEventRepository.java",
              "c": 1
            }
          ],
          "ext": [
            {
              "t": "PG  POST /v1/payments",
