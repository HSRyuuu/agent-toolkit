          "path": "/api/cart",
          "row": 0,
          "desc": "상품을 장바구니에 담는다.",
          "db": []
        },
        {
          "id": "web_order",
          "label": "주문하기",
          "method": "POST",
          "path": "/api/orders",
          "row": 2,
          "desc": "장바구니 상품으로 주문을 만든다.",
          "db": []
        }
      ]
    },
    {
      "id": "order",
      "title": "order-api",
      "sub": "주문 서비스",
      "col": 1,
      "nodes": [
        {
          "id": "o_cart",
          "label": "장바구니 저장",
          "method": "POST",
          "path": "/cart",
          "row": 0,
          "desc": "장바구니 항목을 저장한다.",
          "db": [
            {
              "s": "shop.cart_items",
              "op": "W",
              "n": "사용자·상품·수량 INSERT",
              "e": "CartRepository.java",
              "c": 1
            },
            {
              "s": "shop.products",
              "op": "R",
              "n": "판매 가능 여부 확인",
              "e": "ProductRepository.java",
              "c": 1
            }
          ]
        },
        {
          "id": "o_order",
          "label": "주문 생성",
          "method": "POST",
          "path": "/orders",
          "row": 2,
          "desc": "재고를 차감하고 주문을 저장한 뒤 결제를 요청한다.",
          "db": [
            {
              "s": "shop.orders",
              "op": "W",
              "n": "status=CREATED",
              "e": "OrderRepository.java",
              "c": 1,
              "g": "핵심"
            },
            {
              "s": "shop.order_items",
              "op": "W",
              "e": "OrderRepository.java",
              "c": 1,
              "g": "핵심"
            },
            {
              "s": "shop.products",
              "op": "RU",
              "n": "재고 차감 (stock - qty)",
              "e": "ProductRepository.java",
              "c": 1,
              "g": "핵심"
            },
            {
              "s": "redis:stock:{sku}",
              "op": "RU",
              "n": "재고 캐시",
              "c": 0
            }
          ],
          "ext": [
            {
              "t": "payment-api  POST /charges",
              "n": "동기, 타임아웃 10초",
              "e": "PaymentClient.java"
            }
          ],
          "note": "결제 실패 시 재고를 되돌리는지는 확인하지 못했다."
        },
        {
          "id": "o_paid",
          "label": "결제 완료 수신",
          "method": "Kafka",
          "path": "OrderListener.onOrderPaid",
          "row": 4,
          "desc": "결제 완료 이벤트를 받아 주문 상태를 바꾼다.",
          "db": [
            {
              "s": "shop.orders",
              "op": "U",
              "n": "status=PAID",
              "e": "OrderListener.java",
              "c": 1
            }
          ]
        }
      ]
    },
    {
      "id": "pay",
      "title": "payment-api",
      "sub": "결제 서비스",
